generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ORGANIZER
  REFEREE
  SCORER
  ADMIN
}

enum TournamentStatus {
  DRAFT
  SIGNUPS_OPEN
  SIGNUPS_LOCKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINAL
}

enum MatchClockStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  ENDED
}

enum MatchEventType {
  ONE_POINT_MADE
  ONE_POINT_MISSED
  TWO_POINT_MADE
  TWO_POINT_MISSED
  FREE_THROW_MADE
  FREE_THROW_MISSED
  REBOUND
  ASSIST
  STEAL
  BLOCK
  TURNOVER
  FOUL
}

enum MatchSlot {
  TEAM_A
  TEAM_B
}

enum NotificationType {
  TEAM_INVITE
  MATCH_ASSIGNMENT
  TOURNAMENT_STARTED
  MATCH_SCHEDULE_CHANGED
}

model User {
  id                     String       @id @default(uuid()) @db.Uuid
  email                  String       @unique
  username               String       @unique
  password               String
  firstName              String
  lastName               String
  role                   UserRole     @default(PLAYER)
  tournaments            Tournament[]
  teamMembers            TeamMember[]
  invitedToTeams         TeamInvite[] @relation("InvitedUser")
  sentInvites            TeamInvite[] @relation("Inviter")
  assignedScoringMatches Match[]      @relation("AssignedScorer")
  assignedRefereeMatches Match[]      @relation("AssignedReferee")
  matchEventsAsPlayer    MatchEvent[] @relation("MatchEventPlayer")
  matchEventsAsScorer    MatchEvent[] @relation("MatchEventScorer")
  matchPlayerStats       MatchPlayerStat[]
  notifications          Notification[]
  refereeReports         RefereeReport[]

  @@map("users")
}

model Tournament {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  location    String
  startsAt    DateTime         @db.Timestamptz
  maxTeams    Int              @default(8)
  status      TournamentStatus @default(DRAFT)
  organizerId String           @db.Uuid
  organizer   User             @relation(fields: [organizerId], references: [id])
  teams       Team[]
  matches     Match[]
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  @@map("tournaments")
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  tournamentId String       @db.Uuid
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  members      TeamMember[]
  invites      TeamInvite[]
  matchesAsA   Match[]      @relation("MatchTeamA")
  matchesAsB   Match[]      @relation("MatchTeamB")
  wonMatches   Match[]      @relation("MatchWinner")
  matchEvents  MatchEvent[]
  matchPlayerStats MatchPlayerStat[]
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  @@unique([tournamentId, name])
  @@map("teams")
}

model TeamMember {
  id       String         @id @default(uuid()) @db.Uuid
  teamId   String         @db.Uuid
  team     Team           @relation(fields: [teamId], references: [id])
  userId   String         @db.Uuid
  user     User           @relation(fields: [userId], references: [id])
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @db.Timestamptz

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvite {
  id            String           @id @default(uuid()) @db.Uuid
  teamId        String           @db.Uuid
  team          Team             @relation(fields: [teamId], references: [id])
  invitedUserId String           @db.Uuid
  invitedUser   User             @relation("InvitedUser", fields: [invitedUserId], references: [id])
  inviterId     String           @db.Uuid
  inviter       User             @relation("Inviter", fields: [inviterId], references: [id])
  status        TeamInviteStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @db.Timestamptz
  respondedAt   DateTime?        @db.Timestamptz

  @@index([teamId, invitedUserId], map: "IDX_team_invite_pending_user")
  @@map("team_invites")
}

model Match {
  id                    String           @id @default(uuid()) @db.Uuid
  tournamentId          String           @db.Uuid
  tournament            Tournament       @relation(fields: [tournamentId], references: [id])
  round                 Int
  bracketPosition       Int
  teamAId               String?          @db.Uuid
  teamA                 Team?            @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId               String?          @db.Uuid
  teamB                 Team?            @relation("MatchTeamB", fields: [teamBId], references: [id])
  winnerTeamId          String?          @db.Uuid
  winnerTeam            Team?            @relation("MatchWinner", fields: [winnerTeamId], references: [id])
  scorerId              String?          @db.Uuid
  scorer                User?            @relation("AssignedScorer", fields: [scorerId], references: [id])
  refereeId             String?          @db.Uuid
  referee               User?            @relation("AssignedReferee", fields: [refereeId], references: [id])
  scheduledAt           DateTime?        @db.Timestamptz
  location              String?
  status                MatchStatus      @default(SCHEDULED)
  teamAScore            Int              @default(0)
  teamBScore            Int              @default(0)
  clockStatus           MatchClockStatus @default(NOT_STARTED)
  clockDurationSeconds  Int              @default(600)
  clockRemainingSeconds Int              @default(600)
  clockLastStartedAt    DateTime?        @db.Timestamptz
  nextRound             Int?
  nextBracketPosition   Int?
  nextMatchSlot         MatchSlot?
  events                MatchEvent[]
  playerStats           MatchPlayerStat[]
  refereeReport         RefereeReport?
  createdAt             DateTime         @default(now()) @db.Timestamptz
  updatedAt             DateTime         @updatedAt @db.Timestamptz

  @@unique([tournamentId, round, bracketPosition])
  @@index([tournamentId, status])
  @@index([teamAId])
  @@index([teamBId])
  @@index([scorerId])
  @@index([refereeId])
  @@map("matches")
}

model MatchEvent {
  id         String         @id @default(uuid()) @db.Uuid
  matchId    String         @db.Uuid
  match      Match          @relation(fields: [matchId], references: [id])
  teamId     String         @db.Uuid
  team       Team           @relation(fields: [teamId], references: [id])
  playerId   String?        @db.Uuid
  player     User?          @relation("MatchEventPlayer", fields: [playerId], references: [id])
  scorerId   String         @db.Uuid
  scorer     User           @relation("MatchEventScorer", fields: [scorerId], references: [id])
  type       MatchEventType
  clockRemainingSeconds Int?
  occurredAt DateTime       @default(now()) @db.Timestamptz
  createdAt  DateTime       @default(now()) @db.Timestamptz

  @@index([matchId, occurredAt])
  @@index([teamId])
  @@index([playerId])
  @@index([scorerId])
  @@map("match_events")
}

model MatchPlayerStat {
  id                 String   @id @default(uuid()) @db.Uuid
  matchId            String   @db.Uuid
  match              Match    @relation(fields: [matchId], references: [id])
  teamId             String   @db.Uuid
  team               Team     @relation(fields: [teamId], references: [id])
  playerId           String   @db.Uuid
  player             User     @relation(fields: [playerId], references: [id])
  points             Int      @default(0)
  onePointMade       Int      @default(0)
  onePointAttempted  Int      @default(0)
  twoPointMade       Int      @default(0)
  twoPointAttempted  Int      @default(0)
  freeThrowMade      Int      @default(0)
  freeThrowAttempted Int      @default(0)
  rebounds           Int      @default(0)
  assists            Int      @default(0)
  steals             Int      @default(0)
  blocks             Int      @default(0)
  turnovers          Int      @default(0)
  fouls              Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@map("match_player_stats")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  recipientId  String           @db.Uuid
  recipient    User             @relation(fields: [recipientId], references: [id])
  type         NotificationType
  title        String
  body         String
  tournamentId String?          @db.Uuid
  matchId      String?          @db.Uuid
  teamId       String?          @db.Uuid
  inviteId     String?          @db.Uuid
  readAt       DateTime?        @db.Timestamptz
  createdAt    DateTime         @default(now()) @db.Timestamptz

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([tournamentId])
  @@index([matchId])
  @@index([teamId])
  @@index([inviteId])
  @@map("notifications")
}

model RefereeReport {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @unique @db.Uuid
  match     Match    @relation(fields: [matchId], references: [id])
  refereeId String   @db.Uuid
  referee   User     @relation(fields: [refereeId], references: [id])
  notes     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([refereeId])
  @@map("referee_reports")
}
